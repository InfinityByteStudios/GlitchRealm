{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glitchrealm.ca/changelog/releases.schema.json",
  "title": "GlitchRealm Changelog releases.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "feed": {
      "type": "string",
      "format": "uri"
    },
    "atom": {
      "type": "string",
      "format": "uri"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "latestVersion": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "schema": {
      "type": "string",
      "format": "uri"
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "changes": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "title",
                  "description"
                ]
              }
            }
          },
          "commitRange": {
            "type": "object",
            "properties": {
              "from": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{40}$"
              },
              "to": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          },
          "tag": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "version",
          "title",
          "summary",
          "publishedAt",
          "url",
          "categories",
          "changes",
          "commitRange",
          "tag"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "description",
    "url",
    "feed",
    "generatedAt",
    "latestVersion",
    "count",
    "releases"
  ]
}
